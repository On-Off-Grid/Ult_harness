# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Node / TypeScript (components are fetched via scripts/fetch_components.sh,
# see CREDITS.md — they are not vendored in this repo)
node_modules/
dist/

# Third-party components fetched via scripts/fetch_components.sh (repo root).
# Never commit these — they are other people's repos, and committing their
# paths would create broken gitlinks ("ghost submodules").
Agent-Reach/
Awesome-Redteam/
CL4R1T4S/
T3MP3ST/
adhd/
claude-bug-bounty/
jsleak/
mempalace/

# Runtime state / local workspaces
sessions/*.log
workspace/*/logs/
*.pid
*.sqlite
*.db

# Environment & secrets
.env
.env.*
# the key-NAME template (values blank) is safe to commit
!.env.example
*.pem
*.key
*_token
*_token.txt

# OS / editor
.DS_Store
.idea/
.vscode/

# Operator-fetched scope exports (regenerated by scripts/fetch_intigriti_scope.py)
scope_files/
