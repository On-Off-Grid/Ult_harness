# Ult_harness — environment template (S5 multi-provider routing)
#
# Copy to `.env` at the repo root and fill in values. `.env` is GITIGNORED —
# never commit real keys. Real environment variables always win over `.env`.
#
# The dry-run and the whole test suite need NONE of these. Only live FREE/
# PREMIUM lanes (S5) and a live LOCAL_HEAVY GPU need keys. See docs/provisioning.md
# for what each lane is used for and docs/trust_audit.md for the security posture.

# ── Local ────────────────────────────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
# LOCAL_HEAVY: on-demand Qwen3.8-27B (llama-server) over a private network.
# Leave LOCAL_HEAVY_URL blank to keep the tier OFF (it is $0 and optional).
LOCAL_HEAVY_URL=
LOCAL_HEAVY_API_KEY=
LOCAL_HEAVY_HOURLY_COST=0.40

# ── FREE lane (multi-provider pool) ──────────────────────────────────────
GROQ_API_KEY=            # primary FREE (gpt-oss-120b, qwen/qwen3.8-27b)
OPENROUTER_API_KEY=      # failover layer (1,000 RPD on :free after the $10 top-up)
MISTRAL_API_KEY=         # code lane (Codestral) — opt OUT of data training in console
GITHUB_TOKEN=            # GitHub Models free frontier (GPT-4o, Claude 3.5 Sonnet)
GEMINI_API_KEY=          # long-context RESTRICTED lane (Gemini Flash)
CLOUDFLARE_ACCOUNT_ID=   # optional edge failover (only if you create a token)
CLOUDFLARE_API_TOKEN=

# ── Harness / ports ──────────────────────────────────────────────────────
HARNESS_DRY_RUN=false
HARNESS_API_PORT=8001
HARNESS_MEMPALACE_URL=http://127.0.0.1:8000
HARNESS_WORKSPACE=./workspace
EGRESS_PROXY_PORT=8080
HARNESS_MAX_SESSION_COST=10.00

# ── Platform (operator tooling only — the control plane never calls
#    platform APIs; these keys serve manual/scripted scope fetches) ────────
# Intigriti Researcher API (beta, Bearer auth; 600 GETs / 5 min). Used by
# scripts/fetch_intigriti_scope.py to export a program's scope into a
# Bugcrowd-shaped scope file for `main.py init --format bugcrowd_json`.
INTIGRITI_API_KEY=

# ── Per-provider opt-outs (set =1 to disable a provider regardless of key) ─
# HARNESS_DISABLE_GROQ=0
# HARNESS_DISABLE_OPENROUTER=0
# HARNESS_DISABLE_GITHUB=0
# HARNESS_DISABLE_MISTRAL=0
# HARNESS_DISABLE_GEMINI=0
# HARNESS_DISABLE_CLOUDFLARE=0
# HARNESS_DISABLE_LOCAL_HEAVY=0
